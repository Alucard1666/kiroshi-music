# Maintainer: Kiroshi OS

pkgname=kiroshi-music
pkgver=5.0.0.beta.9
pkgrel=1
pkgdesc='YouTube Music client for Kiroshi OS'
arch=('x86_64')
url='https://github.com/Alucard1666/kiroshi-music'
license=('AGPL-3.0-or-later')
depends=('electron43')
conflicts=('orchard')
replaces=('orchard')
options=('!strip')
source=(
  "$pkgname-$pkgver.tar.zst"
  'kiroshi-music.desktop'
  'kiroshi-music.sh'
)
sha256sums=('d85fe4614e3c7878903f959b1f0a2a538e0702ac20909be57996b37215e9d429' '555f36f2bde2cd5f3cf6dade21a548e711f8ff4f08a12fe46b0dad8a89f1952a' '0e35fedde2b0faa51d1cf36158edfe18350bbc18cc839d1fe66d8237826c7601')

package() {
  install -d "$pkgdir/usr/lib/$pkgname"
  cp -a "$srcdir/$pkgname-$pkgver/." "$pkgdir/usr/lib/$pkgname/"

  install -Dm755 "$srcdir/kiroshi-music.sh" "$pkgdir/usr/bin/kiroshi-music"
  install -Dm644 "$srcdir/kiroshi-music.desktop" \
    "$pkgdir/usr/share/applications/kiroshi-music.desktop"

  for size in 16 32 48 64 128 256 512 1024; do
    if [ -f "$pkgdir/usr/lib/$pkgname/resources/icons/${size}x${size}.png" ]; then
      install -Dm644 "$pkgdir/usr/lib/$pkgname/resources/icons/${size}x${size}.png" \
        "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/kiroshi-music.png"
    fi
  done
  if [ -f "$pkgdir/usr/lib/$pkgname/resources/icons/scalable.svg" ]; then
    install -Dm644 "$pkgdir/usr/lib/$pkgname/resources/icons/scalable.svg" \
      "$pkgdir/usr/share/icons/hicolor/scalable/apps/kiroshi-music.svg"
  fi

  install -Dm644 "$pkgdir/usr/lib/$pkgname/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
